<!DOCTYPE html>
<html lang="sr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Management Report — prototip</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--red:#C90429;--bg:#EDEEEF;--ink:#14161A;--mute:#6B7076;--line:#D5D7DA;--card:#fff;--g4:#2f8f4a;--g1:#d8ecdd;--r1:#f6d5da;--amb:#E7A400;--navy:#20375f}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Montserrat,"Segoe UI",Helvetica,Arial,sans-serif;font-size:13px}
.wrap{max-width:1200px;margin:0 auto;padding:20px 18px 70px}
.banner{background:#fff;border:1px solid var(--line);border-left:3px solid var(--red);padding:11px 14px;font-size:11.5px;color:#3B4046;margin-bottom:14px;line-height:1.55}
.banner b{color:var(--ink)}
h1{font-size:18px;font-weight:700;margin:0 0 2px}.sub{color:var(--mute);font-size:12px;margin:0 0 14px}
.pbi{background:#fff;border:1px solid var(--line)}
.title{background:#12203b;color:#fff;font-weight:700;font-size:13px;padding:9px 14px;display:flex;align-items:center;gap:10px}
.title .seg{margin-left:auto;display:flex;gap:0}
.title .seg button{font:inherit;font-size:10px;border:1px solid #2c4470;background:#17264a;color:#9fb0cf;padding:4px 10px;cursor:pointer}
.title .seg button.on{background:#fff;color:var(--navy);font-weight:700}
.fbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:9px 14px;border-bottom:1px solid var(--line);background:#F7F7F8}
.brand{font-weight:700;color:var(--red);font-size:13px;letter-spacing:.5px}
.sl{border:1px solid var(--line);background:#fff;padding:2px 7px;font-size:9.5px;color:var(--mute)}.sl b{color:var(--ink)}
.kpis{display:flex;border-bottom:1px solid var(--line)}
.kpi{flex:1;padding:12px 14px;border-right:1px solid #EEE}.kpi:last-child{border-right:none}
.kpi .v{font-family:"IBM Plex Mono",monospace;font-size:21px;font-weight:600;line-height:1}
.kpi .l{font-size:8.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--mute);margin-top:3px}
.kpi .d{font-size:10px;margin-top:2px}.up{color:var(--g4)}.dn{color:var(--red)}.fl{color:var(--amb)}
.grid{display:grid;grid-template-columns:1.15fr 1fr;gap:0}
@media(max-width:820px){.grid{grid-template-columns:1fr}}
.panel{padding:12px 14px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.panel:nth-child(2){border-right:none}
.ptitle{font-size:9px;text-transform:uppercase;letter-spacing:.05em;color:var(--mute);font-weight:700;margin-bottom:8px}
table.m{border-collapse:collapse;width:100%;font-size:10.5px;font-family:"IBM Plex Mono",monospace}
table.m th{background:var(--navy);color:#fff;font-family:Montserrat,sans-serif;font-weight:600;font-size:8px;text-transform:uppercase;padding:6px;text-align:right;border:1px solid #2c4470;white-space:nowrap}
table.m th.l{text-align:left}
table.m td{padding:4px 6px;border-bottom:1px solid #EEE;text-align:right;white-space:nowrap}
table.m td.l{text-align:left}
.node{font-family:Montserrat,sans-serif;display:flex;align-items:center;gap:4px}
.tw{display:inline-block;width:12px;height:12px;line-height:10px;text-align:center;border:1px solid #ccc;font-size:9px;cursor:pointer;color:var(--navy);background:#fff;flex:none}
.tw.leaf{border:none;background:none;color:#ccc}
.badge{display:inline-block;font-family:Montserrat,sans-serif;font-size:8px;font-weight:600;padding:1px 6px;border:1px solid}
.b-exc{color:var(--g4);border-color:var(--g4);background:var(--g1)}.b-gro{color:var(--g4);border-color:#5aa06a;background:#e9f3ec}.b-sta{color:var(--mute);border-color:var(--line);background:#f2f2f2}.b-wat{color:#8a6d00;border-color:var(--amb);background:#fbeecb}.b-risk{color:#fff;border-color:var(--red);background:var(--red)}
.bars{display:flex;align-items:flex-end;gap:6px;height:90px;padding-top:6px}
.bars .b{flex:1;background:#8fa9cf;position:relative}.bars .b span{position:absolute;top:-14px;left:0;right:0;text-align:center;font-size:8px;color:var(--mute)}
.bars .lab{text-align:center;font-size:8px;color:var(--mute);margin-top:3px}
.barsx{display:flex;gap:6px;margin-top:3px}.barsx div{flex:1;text-align:center;font-size:8px;color:var(--mute)}
.note{font-size:10px;color:var(--mute);padding:9px 14px;border-top:1px solid var(--line)}.note b{color:var(--ink)}
</style></head><body><div class="wrap">
<div class="banner"><b>Management Report — prototip.</b> Tanak exec pregled. Sliva se exec preklapanje: <b>R6 Daily Report + Business Overview (R2/R6) + −4/5 Dashboard strana (R1) + Risk & Growth status</b>. Tu se R6 rastvara. Podaci uzorak.</div>
<h1>Management Report</h1>
<p class="sub">KPI vs 3M · Markets sa Risk & Growth · Business Overview (Market × kvartal) · drill.</p>

<div class="pbi">
  <div class="title"><span>Management Report</span>
    <div class="seg" id="perseg">
      <button data-p="Daily" >Daily</button><button data-p="MTD" class="on">MTD</button><button data-p="QTD">QTD</button><button data-p="YTD">YTD</button></div>
  </div>
  <div class="fbar"><span class="brand">fazi</span>
    <span class="sl">Region <b>All</b></span><span class="sl">Market <b>All</b></span><span class="sl">Compare <b>3M avg</b></span></div>
  <div class="kpis" id="kpis"></div>
  <div class="grid">
    <div class="panel">
      <div class="ptitle">Markets — Risk &amp; Growth (klik za drill po operateru)</div>
      <table class="m"><thead><tr><th class="l">Market ▾</th><th class="l">Risk &amp; Growth</th><th>GGR</th><th>Total Bet</th><th class="l">vs 3M</th></tr></thead><tbody id="mkt"></tbody></table>
    </div>
    <div class="panel">
      <div class="ptitle">Business Overview — GGR po kvartalu</div>
      <div class="bars" id="bars"></div>
      <div class="barsx" id="barsx"></div>
      <table class="m" style="margin-top:12px"><thead><tr><th class="l">Market</th><th># Games</th><th>Total Bet</th><th>GGR</th><th>Invoice</th></tr></thead><tbody id="bo"></tbody></table>
    </div>
  </div>
  <div class="note" id="note"></div>
</div>

<script>
const MARKETS=[["Curacao","HIGH RISK","b-risk",130.3,"-3M pad","dn"],["Croatia","EXCELLENT","b-exc",66.4,"+akt","up"],["Serbia","GROWTH","b-gro",91.0,"+GGR","up"],["Italy","HIGH RTP (Bad Luck)","b-wat",57.4,"sreća","fl"],["Poland","GROWTH","b-gro",55.2,"+bet","up"],["Brazil","WATCH","b-wat",34.2,"prvi pad","fl"],["Nigeria","STABLE","b-sta",22.1,"~","fl"]];
const OPS={Curacao:["1xbet1","melbet","22bet"],Croatia:["SuperSport","Betano"],Serbia:["MozzartBet","Millennium"],Italy:["Sisal","Snai"],Poland:["STS","Fortuna"],Brazil:["Betano BR"],Nigeria:["Betking"]};
const PER={Daily:{f:0.033,lab:"Yesterday"},MTD:{f:1,lab:"MTD"},QTD:{f:3,lab:"QTD"},YTD:{f:9,lab:"YTD"}};
function seeded(s){return()=>{s=(s*9301+49297)%233280;return s/233280;}}
function hash(str){let h=7;for(const c of str)h=(h*31+c.charCodeAt(0))%99991;return h;}
function fmtM(x){return x>=1e3?(x/1e3).toFixed(1)+"bn":x.toFixed(1)+"M";}
let per="MTD";const expanded=new Set();
const el=id=>document.getElementById(id);
function draw(){
 [...document.querySelectorAll("#perseg button")].forEach(b=>b.classList.toggle("on",b.dataset.p===per));
 const f=PER[per].f;
 const kpis=[["GGR",(35.5*f).toFixed(1)+"M","+0.2%","up"],["Total Bet",(1.10*f).toFixed(2)+"bn","+0.8%","up"],["UAP",(3.60*f).toFixed(2)+"M","-2.4%","dn"],["GGR forecast","57.6M","","fl"],["Avg Fee","7.0%","","fl"]];
 el("kpis").innerHTML=kpis.map(k=>`<div class="kpi"><div class="v">${k[1]}</div><div class="l">${k[0]} · ${per}</div><div class="d ${k[3]}">${k[2]?k[2]+" vs 3M":"&nbsp;"}</div></div>`).join("");
 // markets w/ drill
 let mkt="";MARKETS.forEach(m=>{const id=m[0];const open=expanded.has(id);
   mkt+=`<tr><td class="l"><span class="node"><span class="tw" data-id="${id}">${open?"−":"+"}</span><b>${m[0]}</b></span></td><td class="l"><span class="badge ${m[2]}">${m[1]}</span></td><td>${(m[3]*f).toFixed(1)}M</td><td>${(m[3]*f*24).toFixed(0)}M</td><td class="l ${m[5]}">${m[4]}</td></tr>`;
   if(open)(OPS[m[0]]||[]).forEach(o=>{const r=seeded(hash(o))();mkt+=`<tr><td class="l" style="padding-left:24px;color:#6B7076">${o}</td><td class="l"></td><td>${(m[3]*f*(0.2+r*0.4)).toFixed(1)}M</td><td>${(m[3]*f*(0.2+r*0.4)*24).toFixed(0)}M</td><td></td></tr>`;});
 });
 el("mkt").innerHTML=mkt;
 el("mkt").querySelectorAll(".tw[data-id]").forEach(t=>t.onclick=()=>{const id=t.dataset.id;expanded.has(id)?expanded.delete(id):expanded.add(id);draw();});
 // business overview quarters
 const qs=["Q1 2026","Q2 2026","Q3 2026"];const r=seeded(77);const vals=qs.map(()=>1.3+r()*0.8);
 el("bars").innerHTML=vals.map(v=>`<div class="b" style="height:${v/2.2*84}px"><span>${(v*1000).toFixed(0)}M</span></div>`).join("");
 el("barsx").innerHTML=qs.map(q=>`<div>${q}</div>`).join("");
 let bo="";MARKETS.slice(0,6).forEach(m=>{const rr=seeded(hash("bo"+m[0]));bo+=`<tr><td class="l">${m[0]}</td><td>${Math.round(rr()*400+50)}</td><td>${(m[3]*f*24).toFixed(0)}M</td><td>${(m[3]*f).toFixed(1)}M</td><td>${(m[3]*f*0.9).toFixed(1)}M</td></tr>`;});
 el("bo").innerHTML=bo;
 el("note").innerHTML=`<b>Kako:</b> exec sloj — KPI (${per}) vs 3M · Markets sa Risk & Growth (R1 engine) + drill po operateru · Business Overview (Market × kvartal, iz R2/R6). Period toggle = R6 Daily/MTD/QTD. <b>Tu se R6 rastvara</b> (Daily Report + Business Overview → ovde). CTA: HIGH RISK / u padu → prioritet menadžmenta.`;
}
document.querySelectorAll("#perseg button").forEach(b=>b.onclick=()=>{per=b.dataset.p;draw();});
draw();
</script>
</div></body></html>
